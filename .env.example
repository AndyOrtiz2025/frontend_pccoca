# Copia este archivo como .env.local y llena los valores. El .env.local NUNCA se sube al repo.

# URL del backend (Spring Boot). Solo la usa el servidor de Next.js (patrón BFF),
# por eso no lleva el prefijo NEXT_PUBLIC_ y nunca llega al navegador.
BACKEND_URL=http://localhost:8080

# Mientras el backend no esté listo, el frontend usa datos de prueba.
USE_MOCKS=true

# Clave para firmar la cookie de sesión. Mínimo 32 caracteres, distinta en cada ambiente.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
